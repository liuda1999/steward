# 上游凭据，绝不能进仓库
.env
.env.*
*.key
*.pem

# 本地运行配置：首次启动时由 steward/config.example.yaml 生成。
# 里面有用户自己的地址、模型标识和端口，不该进仓库。
# 注意只忽略仓库根目录这一份，包里的模板（steward/config.example.yaml）要进。
/config.yaml
/config.example.yaml

# 运行时状态：签发的 key（只存 hash）、配额、估算系数、骨架缓存、控制台口令、
# 临时验证目录。整个目录都是跑出来的，不该有任何一个文件进仓库。
# 测试要用的历史样本放在 tests/fixtures/。
state/

# 交付物与工具输出存档（可能是源码片段，也不该进仓库）
.steward/
.cloudbridge/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/

# 测试
.pytest_cache/
.pytest_tmp/
.coverage
htmlcov/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*~

# 临时文件
*.bak
*.orig
*.rej

# 控制台口令
console.token
